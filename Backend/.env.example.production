# ====================================================
# GBS HOSPITAL MANAGEMENT SYSTEM — PRODUCTION ENV TEMPLATE
# Copy to Backend/.env.production or configure in Render Dashboard
# NEVER commit real passwords, JWT secrets, or live DB URLs to Git
# ====================================================

NODE_ENV=production
GBS_ENV=PRODUCTION
PORT=5000
HOST=0.0.0.0

# Render Managed PostgreSQL Connection String & Safe Pool Tuning
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gbs_hospital?sslmode=require
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
DB_SOCKET_TIMEOUT=30
DB_PGBOUNCER=false
DB_STORAGE_QUOTA_MB=1024
RENDER_INSTANCE_COUNT=1

# Cryptographically strong 64+ character JWT secret (set via Render secret generator)
JWT_SECRET=REPLACE_WITH_64_CHAR_CRYPTO_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# Strict Production CORS allowlist (comma-separated, NEVER '*' in production)
CORS_ORIGIN=https://gbs-hospital-system.onrender.com
PRODUCTION_PUBLIC_URL=https://gbs-hospital-system.onrender.com
RENDER_SERVICE_NAME=gbs-hospital-system
OFFICIAL_COMPANY_EMAIL=gabosei48@gmail.com

# Security & Session Protection
ENABLE_RATE_LIMIT=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000
DEMO_MODE_ENABLED=false

# Production Bootstrap Credentials (used ONLY when Root Developer / Bootstrap Admin do not yet exist)
DEVELOPER_ROOT_EMAIL=gabosei48@gmail.com
DEVELOPER_ROOT_PASSWORD=SET_IN_RENDER_ENVIRONMENT_SECRETS
DEVELOPER_MFA_TOTP_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@gbs.com
BOOTSTRAP_ADMIN_PASSWORD=SET_IN_RENDER_ENVIRONMENT_SECRETS

# Optional Real External Adapters (leave blank if not provisioned; system reports honest status)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_PROVIDER=
SMS_API_KEY=
REDIS_URL=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
