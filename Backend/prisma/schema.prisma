generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ====================================================
 * GBS HOSPITAL MANAGEMENT SYSTEM
 * DATABASE CORE SCHEMA
 * PHASE 2
 * PART 2
 * PRODUCTION HARDENED
 * COMMONJS BACKEND COMPATIBLE
 * ====================================================
 */

model Role {
  id String @id @default(uuid())

  name String @unique

  description String?

  permissions Permission[]

  users User[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Permission {
  id String @id @default(uuid())

  name String @unique

  description String?

  roles Role[]

  createdAt DateTime @default(now())
}

model User {
  id String @id @default(uuid())

  firstName String

  lastName String

  email String @unique

  password String

  roleId String

  role Role @relation(fields: [roleId], references: [id])

  active Boolean @default(true)

  lastLogin DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  sessions Session[]

  patient Patient?

  @@index([email])
  @@index([active])
}

model Session {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  ipAddress String?

  userAgent String?

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(uuid())

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  action String

  module String

  description String?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model Hospital {
  id String @id @default(uuid())

  name String

  code String @unique

  registrationNumber String? @unique

  email String?

  phone String?

  website String?

  address String?

  city String?

  state String?

  country String?

  logo String?

  timezone String @default("UTC")

  active Boolean @default(true)

  deletedAt DateTime?

  tenant Tenant?

  branches HospitalBranch[]

  settings HospitalSetting[]

  hospitalWards HospitalWard[]

  rooms HospitalRoom[]

  staff HospitalStaff[]

  departments HospitalDepartment[]

  hospitalBeds HospitalBed[]

  units HospitalUnit[]

  patientLocations HospitalPatientLocation[]

  admissions HospitalAdmission[]

  patients Patient[]
  folders  MedicalFolder[]
  queueTickets OpdQueueTicket[]

  pharmacyItems PharmacyItem[]

  pharmacyInventory PharmacyInventory[]

  pharmacyBatches PharmacyBatch[]

  prescriptionDispenses PrescriptionDispense[]

  pharmacyStockMovements PharmacyStockMovement[]

  createdAt DateTime @default(now())

  updatedAt         DateTime           @updatedAt
  patientEncounters PatientEncounter[]

  @@index([active])
  @@index([deletedAt])
  @@index([country])
  @@index([city])
}

model HospitalBranch {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  name String

  code String

  address String?

  city String?

  state String?

  country String?

  phone String?

  email String?

  active Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([active])
  @@index([deletedAt])
}

model HospitalSetting {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  key String

  value String

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([hospitalId, key])
  @@index([hospitalId])
  @@index([deletedAt])
}

model HospitalRoom {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  wardId String

  ward HospitalWard @relation(fields: [wardId], references: [id], onDelete: Cascade)

  name String

  code String

  floor String?

  roomType String?

  description String?

  active Boolean @default(true)

  deletedAt DateTime?

  beds HospitalBed[]

  patientLocations HospitalPatientLocation[]

  admissions HospitalAdmission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([wardId])
  @@index([active])
  @@index([deletedAt])
}

model HospitalDepartment {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  units HospitalUnit[]

  name String

  code String

  description String?

  active Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model HospitalWard {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  unitId String?

  unit HospitalUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  rooms HospitalRoom[]

  name String

  code String

  description String?

  capacity Int @default(0)

  active Boolean @default(true)

  deletedAt DateTime?

  admissions HospitalAdmission[]

  createdAt DateTime @default(now())

  updatedAt                DateTime                  @updatedAt
  hospitalPatientLocations HospitalPatientLocation[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([unitId])
}

model HospitalBed {
  id String @id @default(uuid())

  roomId String
  room   HospitalRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  name String

  code String

  bedNumber String

  status String @default("AVAILABLE")

  bedType String?

  description String?

  active Boolean @default(true)

  deletedAt DateTime?

  patientLocations HospitalPatientLocation[]

  admissions HospitalAdmission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([roomId, code])
  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@index([hospitalId])
  @@index([status])
  @@index([active])
  @@index([deletedAt])
}

enum StaffType {
  DOCTOR
  NURSE
  PHARMACIST
  LAB_TECHNICIAN
  CASHIER
  ADMIN
}

model HospitalStaff {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  firstName String

  lastName String

  employeeCode String

  email String?

  phone String?

  position String?

  department String?

  staffType StaffType

  specialization String?

  licenseNumber String?

  active Boolean @default(true)

  deletedAt DateTime?

  assignedEncounters PatientEncounter[]

  consultations PatientConsultation[]

  nursingRecords NursingRecord[]

  requestedLaboratoryRequests LaboratoryRequest[] @relation("LaboratoryRequestedBy")

  performedLaboratoryRequests LaboratoryRequest[] @relation("LaboratoryPerformedBy")

  discharges DischargeRecord[]

  prescriptions PatientPrescription[]

  dispensedPrescriptions PrescriptionDispense[]

  stockMovements PharmacyStockMovement[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([hospitalId, employeeCode])
  @@index([hospitalId])
  @@index([staffType])
  @@index([active])
}

model HospitalUnit {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  departmentId String
  department   HospitalDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  wards HospitalWard[]

  name String

  code String

  description String?

  active Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([departmentId])
}

model HospitalPatientLocation {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  wardId String?
  ward   HospitalWard? @relation(fields: [wardId], references: [id], onDelete: SetNull)

  roomId String?
  room   HospitalRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  bedId String?
  bed   HospitalBed? @relation(fields: [bedId], references: [id], onDelete: SetNull)

  status String @default("ACTIVE")

  admittedAt DateTime @default(now())

  dischargedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([hospitalId])
  @@index([patientId])
  @@index([wardId])
  @@index([roomId])
  @@index([bedId])
  @@index([status])
}

model HospitalAdmission {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  wardId String?
  ward   HospitalWard? @relation(fields: [wardId], references: [id], onDelete: SetNull)

  roomId String?
  room   HospitalRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  bedId String?
  bed   HospitalBed? @relation(fields: [bedId], references: [id], onDelete: SetNull)

  admissionNumber String @unique

  admissionType String @default("GENERAL")

  status String @default("ADMITTED")

  admittedAt DateTime @default(now())

  dischargedAt DateTime?

  notes String?

  encounterId String?

  admittingDoctorId String?

  admittingDoctorName String?

  admissionDiagnosis String?

  dischargeSummary String?

  dischargeCondition String?

  dischargeDisposition String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
}

model Patient {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  patientNumber String @unique

  firstName String

  lastName String

  middleName String?

  dateOfBirth DateTime?

  gender String?

  phone String?

  email String?

  address String?

  emergencyContact String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?

  nationalId String?
  nhisNumber String?
  occupation String?
  maritalStatus String?
  nationality String? @default("Ghanaian")
  bloodGroup String?
  genotype String?
  photoUrl String?

  userId String? @unique
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  deletedAt DateTime?

  folder MedicalFolder?
  retrievalRequests FolderRetrievalRequest[]
  queueTickets OpdQueueTicket[]

  admissions HospitalAdmission[]

  locations HospitalPatientLocation[]

  profile PatientProfile?

  medicalRecords PatientMedicalRecord[]

  allergies PatientAllergy[]

  vitalSigns PatientVitalSign[]

  medications PatientMedication[]

  clinicalNotes PatientClinicalNote[]

  createdAt DateTime @default(now())

  updatedAt         DateTime           @updatedAt
  patientEncounters PatientEncounter[]
  radiologyOrders   RadiologyOrder[]
  bills             PatientBill[]
  surgicalCases     SurgicalCase[]
  emergencyCases    EmergencyCase[]
  transfusionRequests BloodTransfusionRequest[]
  corpseRecords     CorpseRecord[]

  @@index([hospitalId])
  @@index([patientNumber])
  @@index([nationalId])
  @@index([nhisNumber])
  @@index([phone])
  @@index([active])
}

model PatientEncounter {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  encounterNumber String @unique

  encounterType String
  // OUTPATIENT
  // INPATIENT
  // EMERGENCY
  // FOLLOWUP

  status String @default("OPEN")
  // OPEN
  // COMPLETED
  // CANCELLED

  visitDate DateTime @default(now())

  chiefComplaint String?

  notes String?

  createdBy String?

  consultations PatientConsultation[]

  diagnoses PatientDiagnosis[]

  prescriptions PatientPrescription[]

  laboratoryRequests LaboratoryRequest[]
  radiologyOrders    RadiologyOrder[]

  bills PatientBill[]
  surgicalCases     SurgicalCase[]

  nursingRecords NursingRecord[]

  dischargeRecord DischargeRecord?

  assignedStaffId String?

  assignedStaff HospitalStaff? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  workflow ClinicalWorkflow?
  queueTicket OpdQueueTicket?
  vitalSigns PatientVitalSign[]

  queueToken String?
  priority String @default("ROUTINE") // ROUTINE, PRIORITY, EMERGENCY
  triageStatus String @default("WAITING_TRIAGE") // WAITING_TRIAGE, TRIAGED, WAITING_DOCTOR, IN_CONSULTATION, COMPLETED
  triageRiskLevel String? // LOW, MEDIUM, HIGH, CRITICAL
  triageNotes String?
  assignedRoom String?
  assignedDoctorId String?
  assignedDoctorName String?

  triagedAt DateTime?
  consultationStartedAt DateTime?
  consultationCompletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([patientId])
  @@index([hospitalId])
  @@index([encounterNumber])
  @@index([status])
  @@index([triageStatus])
  @@index([priority])
}

model PatientConsultation {
  id String @id @default(uuid())

  encounterId String
  encounter   PatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  doctorId String?
  doctor   HospitalStaff? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  consultationType String?

  history String?

  examination String?

  assessment String?

  plan String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([encounterId])
  @@index([doctorId])
}

model PatientDiagnosis {
  id String @id @default(uuid())

  encounterId String
  encounter   PatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  diagnosisCode String?

  diagnosisName String

  diagnosisType String?
  // PRIMARY
  // SECONDARY

  notes String?

  createdAt DateTime @default(now())

  @@index([encounterId])
}

model PatientPrescription {
  id String @id @default(uuid())

  encounterId String

  encounter PatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  medicationName String

  dosage String?

  frequency String?

  duration String?

  instructions String?

  status String @default("ACTIVE")

  prescribedById String?

  prescribedBy HospitalStaff? @relation(fields: [prescribedById], references: [id], onDelete: SetNull)

  dispense PrescriptionDispense?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([encounterId])
  @@index([prescribedById])
}

model LaboratoryRequest {
  id String @id @default(uuid())

  encounterId String

  encounter PatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  requestNumber String? @unique

  requestedById String?

  requestedBy HospitalStaff? @relation("LaboratoryRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  performedById String?

  performedBy HospitalStaff? @relation("LaboratoryPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  testName String

  testCode String?

  department String?

  priority String? @default("ROUTINE")

  clinicalNotes String?

  specimenType String?

  status String @default("REQUESTED")

  result String?

  resultDate DateTime?

  verifiedById String?

  verifiedByName String?

  verifiedAt DateTime?

  samples LaboratorySample[]

  testResults LaboratoryTestResult[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([encounterId])
  @@index([requestedById])
  @@index([performedById])
  @@index([status])
}

model LaboratorySample {
  id String @id @default(uuid())

  sampleBarcode String @unique

  requestId String

  request LaboratoryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  patientId String?

  specimenType String

  tubeColor String?

  collectionVolume String?

  collectedAt DateTime @default(now())

  collectedById String?

  collectedByName String?

  receivedAt DateTime?

  receivedById String?

  receivedByName String?

  status String @default("COLLECTED")

  rejectionReason String?

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([sampleBarcode])
  @@index([status])
}

model LaboratoryTestResult {
  id String @id @default(uuid())

  requestId String

  request LaboratoryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  parameterName String

  parameterCode String?

  measuredValue String

  numericValue Float?

  unit String?

  referenceRangeMin Float?

  referenceRangeMax Float?

  referenceRangeText String?

  abnormalFlag String?

  notes String?

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([parameterName])
}

model LaboratoryCatalogItem {
  id String @id @default(uuid())

  testCode String @unique

  testName String

  department String

  specimenType String

  containerTube String

  turnaroundHours Int @default(4)

  costPrice Float @default(0.0)

  sellingPrice Float @default(0.0)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([active])
}

/**
 * ====================================================
 * GBS RADIOLOGY, PACS & DICOM DIAGNOSTIC SUBSYSTEM
 * ====================================================
 */

model RadiologyOrder {
  id String @id @default(uuid())

  encounterId String
  encounter   PatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  accessionNumber String @unique

  modality String // XRAY, CT_SCAN, MRI, ULTRASOUND, MAMMOGRAPHY, FLUOROSCOPY, ECHOCARDIOGRAM
  procedureName String
  procedureCode String?
  bodyPart String // CHEST, BRAIN, ABDOMEN, SPINE, PELVIS, EXTREMITY, NECK, CARDIAC
  priority String @default("ROUTINE") // ROUTINE, URGENT, STAT_EMERGENCY
  clinicalIndication String?

  status String @default("ORDERED") // ORDERED, SCHEDULED, ACQUISITION_IN_PROGRESS, ACQUIRED, REPORTED, VERIFIED, CANCELLED

  requestedById String?
  requestedByName String?
  requestedByRole String? @default("DOCTOR")

  scheduledDate DateTime?

  performingRadiographerId String?
  performingRadiographerName String?

  studies DicomStudy[]
  reports RadiologyReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([encounterId])
  @@index([patientId])
  @@index([accessionNumber])
  @@index([modality])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
}

model DicomStudy {
  id String @id @default(uuid())

  orderId String
  order   RadiologyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  studyInstanceUid String @unique
  seriesInstanceUid String?
  sopClassUid String?

  modality String
  patientId String?
  patientName String?
  accessionNumber String?

  seriesCount Int @default(1)
  instanceCount Int @default(1)

  imageStorageUri String?
  thumbnailUri String?

  windowWidth Float?
  windowCenter Float?
  kvp Float?
  exposureTime Float?
  sliceThickness Float?
  pixelSpacing String?
  patientPosition String?
  acquisitionDevice String?
  notes String?

  acquiredAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([studyInstanceUid])
  @@index([modality])
  @@index([acquiredAt])
}

model RadiologyReport {
  id String @id @default(uuid())

  orderId String
  order   RadiologyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  studyId String?

  reportNumber String @unique

  modality String
  radiologistId String?
  radiologistName String?

  technique String?
  comparison String?
  findings String
  impression String

  classification String @default("NORMAL") // NORMAL, ABNORMAL, INCONCLUSIVE, CRITICAL_PANIC
  criticalAlert Boolean @default(false)
  criticalAlertNotes String?

  status String @default("DRAFT") // DRAFT, PRELIMINARY, VERIFIED_FINAL

  verifiedById String?
  verifiedByName String?
  signedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([reportNumber])
  @@index([status])
  @@index([classification])
  @@index([criticalAlert])
  @@index([createdAt])
}

model RadiologyCatalogItem {
  id String @id @default(uuid())

  code String @unique
  modality String
  procedureName String
  bodyPart String
  standardViews String?
  defaultWindowWidth Float?
  defaultWindowCenter Float?
  estimatedMinutes Int @default(15)
  costPrice Float @default(0.0)
  sellingPrice Float @default(0.0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modality])
  @@index([bodyPart])
  @@index([active])
}

/**
 * ====================================================
 * GBS BILLING, INVOICING, NHIS & CLAIMS SUBSYSTEM
 * ====================================================
 */

model PatientBill {
  id String @id @default(uuid())

  encounterId String
  encounter   PatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  billNumber String @unique
  billDate DateTime @default(now())

  payorType String @default("CASH") // CASH, NHIS, PRIVATE_INSURANCE, SPLIT
  insuranceProvider String?
  insurancePolicyNumber String?

  grossAmount Decimal @db.Decimal(10, 2) @default(0.00)
  discountAmount Decimal @db.Decimal(10, 2) @default(0.00)
  nhisCoveredAmount Decimal @db.Decimal(10, 2) @default(0.00)
  insuranceCoveredAmount Decimal @db.Decimal(10, 2) @default(0.00)
  patientPayableAmount Decimal @db.Decimal(10, 2) @default(0.00)
  paidAmount Decimal @db.Decimal(10, 2) @default(0.00)
  balanceDue Decimal @db.Decimal(10, 2) @default(0.00)
  amount Decimal @db.Decimal(10, 2) @default(0.00)

  paymentStatus String @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, VOIDED, REFUNDED
  description String?
  notes String?

  issuedById String?
  issuedByName String?

  items BillItem[]
  payments PatientPayment[]
  claims InsuranceClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([encounterId])
  @@index([patientId])
  @@index([billNumber])
  @@index([paymentStatus])
  @@index([payorType])
}

model BillItem {
  id String @id @default(uuid())

  billId String
  bill   PatientBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  category String // CONSULTATION, PHARMACY, LABORATORY, RADIOLOGY, ADMISSION, PROCEDURE, GENERAL
  serviceCode String?
  serviceName String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity Int @default(1)
  totalAmount Decimal @db.Decimal(10, 2)

  nhisCovered Boolean @default(false)
  nhisRate Decimal @db.Decimal(10, 2) @default(0.00)

  referenceId String?
  notes String?

  createdAt DateTime @default(now())

  @@index([billId])
  @@index([category])
  @@index([serviceCode])
}

model PatientPayment {
  id String @id @default(uuid())

  billId String
  bill   PatientBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  receiptNumber String @unique
  amount Decimal @db.Decimal(10, 2)
  paymentMethod String // CASH, MOBILE_MONEY, BANK_CARD, BANK_TRANSFER, CHEQUE
  paymentReference String?
  paymentDate DateTime @default(now())

  receivedById String?
  receivedByName String?
  notes String?

  createdAt DateTime @default(now())

  @@index([billId])
  @@index([receiptNumber])
  @@index([paymentMethod])
  @@index([paymentDate])
}

model InsuranceClaim {
  id String @id @default(uuid())

  billId String
  bill   PatientBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  claimNumber String @unique
  patientId String?
  payorType String // NHIS, PRIVATE_INSURANCE
  insuranceProvider String
  policyNumber String

  claimedAmount Decimal @db.Decimal(10, 2)
  approvedAmount Decimal? @db.Decimal(10, 2)
  status String @default("GENERATED") // GENERATED, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, SETTLED

  icd10Diagnosis String?
  submittedAt DateTime?
