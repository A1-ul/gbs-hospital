# Dependencies
node_modules/
*/node_modules/

# Environment variables (NEVER commit real secrets)
.env
.env.*
*.env
!.env.example
!.env.example.production
!Backend/.env.example
!Backend/.env.example.production
!Frontend/.env.example

# Database backups & runtime artifacts (NEVER commit DB dumps to Git)
Backend/backups/*.json
!Backend/backups/facility-branding.json

# Build / Vite temporary artifacts
Frontend/dist/
Frontend/vite.config.js.timestamp-*.mjs

# Logs & Debugging
logs/
Backend/logs/*.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage and test output
coverage/
.nyc_output/

# OS metadata
.DS_Store
Thumbs.db

# CI jest machine-readable output
Backend/jest-results.json

# Runtime locale persistence
storage/locale-profile.json
